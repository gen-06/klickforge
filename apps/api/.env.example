# ClipForge API — environment template
#
# Copy this file to `.env` in this directory (apps/api/.env) for local
# development, and set the same keys in your Railway service's variables
# for production/staging. Never commit the real `.env` file.
#
# Local dev: `cp .env.example .env` then fill in the values below.
# Railway:   set these under Project > Service > Variables (or via
#            `railway variables set KEY=value`). Use Railway's Postgres and
#            Redis plugins to get DATABASE_URL / REDIS_URL automatically —
#            reference them as ${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}}.

# --- Core services (Railway Postgres / Redis) ---
# Railway injects these automatically when you attach the Postgres/Redis
# plugins to this service; for local dev point at a local or dev instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtubers
REDIS_URL=redis://localhost:6379/0

# Comma-separated list is NOT supported here — this must be a JSON array
# string, e.g. '["https://app.example.com","https://www.example.com"]'
CORS_ORIGINS=["http://localhost:3000"]

# --- Clerk auth (dashboard.clerk.com > API Keys) ---
# Must match the Clerk instance used by apps/web.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_VERIFY_TOKENS=true

# --- Admin access ---
# Comma-separated emails allowed to view waitlist/export endpoints.
ADMIN_EMAILS=you@example.com

# --- AI / subtitles & clip scoring (platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-replace_with_your_openai_api_key

# --- Paddle billing (vendors.paddle.com > Developer Tools > Authentication) ---
PADDLE_ENV=sandbox
PADDLE_SANDBOX_API_KEY=replace_with_paddle_sandbox_api_key
PADDLE_LIVE_API_KEY=replace_with_paddle_live_api_key
PADDLE_WEBHOOK_SECRET=replace_with_paddle_webhook_secret
PADDLE_PRICE_STARTER_MONTH=pri_replace_me
PADDLE_PRICE_STARTER_YEAR=pri_replace_me
PADDLE_PRICE_PRO_MONTH=pri_replace_me
PADDLE_PRICE_PRO_YEAR=pri_replace_me
PADDLE_PRICE_ADVANCED_MONTH=pri_replace_me
PADDLE_PRICE_ADVANCED_YEAR=pri_replace_me
# Optional one-time credit top-up packs — leave all three blank, or set all three.
PADDLE_PRICE_CREDITS_SMALL=
PADDLE_PRICE_CREDITS_MEDIUM=
PADDLE_PRICE_CREDITS_LARGE=

# --- Deployment / monitoring ---
ENVIRONMENT=development
SENTRY_DSN=

# --- Object storage: Cloudflare R2 (S3-compatible) ---
# R2 dashboard > Manage R2 API Tokens for access/secret keys.
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# There is no separate "internal" endpoint in production (that was only
# needed for the old Docker/MinIO setup) — both should point at R2.
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_INTERNAL_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=replace_with_r2_access_key_id
STORAGE_SECRET_KEY=replace_with_r2_secret_access_key
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_CLIPS=clips
# Public URL clips are served from — an R2 custom domain (recommended) or
# the bucket's r2.dev dev URL, e.g. https://clips.yourdomain.com
STORAGE_PUBLIC_URL=https://<your-public-clips-domain>
STORAGE_USE_SSL=true

# --- Processing ---
MAX_UPLOAD_SIZE_MB=2048
CLIP_MIN_DURATION_SECONDS=30
CLIP_MAX_DURATION_SECONDS=90
CLIP_TARGET_COUNT=5
