# ClipForge Web — environment template
#
# Next.js only reads .env files from this directory (apps/web), not the repo
# root. Copy this to `.env.local` for local dev (Next.js convention, always
# gitignored) and set the same keys as Vercel Project > Settings >
# Environment Variables for production/preview.

# --- API backend ---
# Local dev: your local API (uvicorn) or a Railway staging URL.
# Production: your Railway API's public URL, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# The canonical URL of this Next.js app itself (used for share links, sitemap, etc).
# Production: your Vercel domain, e.g. https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk auth (dashboard.clerk.com > API Keys) ---
# Must match the Clerk instance used by apps/api.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# --- Paddle billing (client-side checkout) ---
# Client-side token from Paddle dashboard > Developer Tools > Authentication
# > Client-side tokens (sandbox tokens are prefixed "test_"). This is safe to
# expose to the browser — it is NOT the API key used by apps/api.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_side_token
# Must be "sandbox" or "live" — read at build/render time and the app fails
# loudly (see lib/env.ts getRequiredEnv) if this is unset, rather than
# silently defaulting, so you can never accidentally hit the wrong account.
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Price IDs from Paddle > Catalog > Prices (one per tier per billing cycle).
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=pri_replace_me
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=pri_replace_me
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_replace_me
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_replace_me
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=pri_replace_me
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=pri_replace_me
