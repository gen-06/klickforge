# Environment mode: development or production
ENVIRONMENT=development

# Frontend API URL (used by apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public app URL (used for sitemap and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtubers

# Database credentials used by docker-compose.prod.yml when self-hosting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youtubers

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# Clerk authentication
# Get these from https://dashboard.clerk.com/last-active?path=api-keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk issuer URL. If omitted, it is derived from CLERK_PUBLISHABLE_KEY.
CLERK_ISSUER=
# Set to false to disable JWT verification and run in demo mode (not for production)
CLERK_VERIFY_TOKENS=true

# Admin emails allowed to view waitlist/export data (comma-separated)
ADMIN_EMAILS=you@example.com

# OpenAI (used for transcription, translation, and voiceover)
OPENAI_API_KEY=sk-...

# Object storage (S3-compatible). Defaults below work with local MinIO.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_CLIPS=clips
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_USE_SSL=false

# Paddle billing
# Get API keys from https://sandbox-vendors.paddle.com/ (sandbox) or https://vendors.paddle.com/ (live)
PADDLE_SANDBOX_API_KEY=pdl_test_...
PADDLE_LIVE_API_KEY=pdl_live_...
# Webhook signing secret from Developer tools > Notifications
PADDLE_WEBHOOK_SECRET=pdl_ntfs_...
# sandbox or live
PADDLE_ENV=sandbox
# Client-side token for Paddle.js (create in Dashboard > Developer tools > Client-side tokens)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Subscription price IDs (server-side)
PADDLE_PRICE_STARTER_MONTH=pri_...
PADDLE_PRICE_STARTER_YEAR=pri_...
PADDLE_PRICE_PRO_MONTH=pri_...
PADDLE_PRICE_PRO_YEAR=pri_...
PADDLE_PRICE_ADVANCED_MONTH=pri_...
PADDLE_PRICE_ADVANCED_YEAR=pri_...

# One-time credit top-up pack price IDs (server-side; optional, set all three to enable top-ups)
PADDLE_PRICE_CREDITS_SMALL=pri_...
PADDLE_PRICE_CREDITS_MEDIUM=pri_...
PADDLE_PRICE_CREDITS_LARGE=pri_...

# Subscription price IDs (client-side, required by apps/web pricing page)
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=pri_...
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=pri_...
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=pri_...
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=pri_...
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=pri_...

# Optional: Sentry DSN for error tracking (https://sentry.io/)
SENTRY_DSN=

# Optional processing limits
MAX_UPLOAD_SIZE_MB=2048
CLIP_MIN_DURATION_SECONDS=30
CLIP_MAX_DURATION_SECONDS=90
CLIP_TARGET_COUNT=5
