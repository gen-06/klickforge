# ClipForge — environment variables (production reference)
#
# This file is the single source of truth for every environment variable
# the app needs, matching docs/deployment.md. It is NOT loaded automatically
# by either app — copy the relevant values into the file each tool actually
# reads:
#
#   apps/api/.env        <- backend vars (FastAPI + Celery worker, local dev)
#   apps/web/.env.local   <- NEXT_PUBLIC_*/CLERK_SECRET_KEY vars (Next.js, local dev)
#
# In production:
#   - apps/api / worker run on Railway  -> set these under Service > Variables.
#   - apps/web runs on Vercel           -> set the NEXT_PUBLIC_*/CLERK_SECRET_KEY
#                                          ones under Project > Settings > Environment Variables.
#   - Object storage is Cloudflare R2 (S3-compatible).
#
# infra/docker-compose*.yml (local Postgres/Redis/MinIO) predate the move to
# managed cloud services and are not part of the current deploy path.

ENVIRONMENT=production

# --- Database & Redis (Railway Postgres / Redis plugins) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://host:6379/0

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["https://yourdomain.com"]

# --- Clerk auth (dashboard.clerk.com > API Keys) ---
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_ISSUER=https://your-domain.clerk.accounts.dev
CLERK_VERIFY_TOKENS=true

# --- Admin access (comma-separated emails) ---
ADMIN_EMAILS=you@example.com

# --- AI / subtitles & clip scoring ---
OPENAI_API_KEY=sk-replace_me

# --- Paddle billing (vendors.paddle.com) ---
PADDLE_ENV=live
PADDLE_SANDBOX_API_KEY=
PADDLE_LIVE_API_KEY=pdl_live_apikey_replace_me
PADDLE_WEBHOOK_SECRET=pdl_nslt_replace_me
PADDLE_PRICE_STARTER_MONTH=pri_replace_me
PADDLE_PRICE_STARTER_YEAR=pri_replace_me
PADDLE_PRICE_PRO_MONTH=pri_replace_me
PADDLE_PRICE_PRO_YEAR=pri_replace_me
PADDLE_PRICE_ADVANCED_MONTH=pri_replace_me
PADDLE_PRICE_ADVANCED_YEAR=pri_replace_me
# Optional one-time credit top-up packs — leave all three blank, or set all three.
PADDLE_PRICE_CREDITS_SMALL=
PADDLE_PRICE_CREDITS_MEDIUM=
PADDLE_PRICE_CREDITS_LARGE=

# --- Monitoring ---
SENTRY_DSN=

# --- Object storage: Cloudflare R2 (S3-compatible) ---
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_INTERNAL_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_CLIPS=clips
STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
STORAGE_USE_SSL=true

# --- Processing ---
MAX_UPLOAD_SIZE_MB=2048
CLIP_MIN_DURATION_SECONDS=30
CLIP_MAX_DURATION_SECONDS=90
CLIP_TARGET_COUNT=5

# --- Frontend (Vercel / apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
NEXT_PUBLIC_PADDLE_ENV=live
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_replace_me
